{
  "name": "@trueyy/node",
  "version": "1.1.0",
  "description": "Trueyy Server SDK for Node.js — mint session tokens, query sessions, handle webhooks.",
  "license": "MIT",
  "homepage": "https://github.com/Anti-Cheating/trueyy-sdk/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/Anti-Cheating/trueyy-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anti-Cheating/trueyy-sdk.git",
    "directory": "packages/node"
  },
  "keywords": [
    "trueyy",
    "sdk",
    "interview",
    "ats",
    "anti-cheating",
    "monitoring",
    "webhooks"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 --test-force-exit tests/*.test.ts",
    "test:cov": "tsx --test --test-concurrency=1 --test-force-exit --experimental-test-coverage --test-coverage-include=src/** --test-coverage-exclude=src/types.ts tests/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
