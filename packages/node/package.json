{
  "name": "@trueyy/node",
  "version": "1.0.0",
  "description": "Trueyy Server SDK for Node.js — mint session tokens, query sessions, handle webhooks.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
