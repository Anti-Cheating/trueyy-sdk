{
  "name": "@trueyy/web",
  "version": "1.0.0",
  "description": "React components for embedding Trueyy interview monitoring.",
  "license": "MIT",
  "homepage": "https://github.com/Anti-Cheating/trueyy-sdk/tree/main/packages/web-react#readme",
  "bugs": {
    "url": "https://github.com/Anti-Cheating/trueyy-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anti-Cheating/trueyy-sdk.git",
    "directory": "packages/web-react"
  },
  "keywords": [
    "trueyy",
    "sdk",
    "interview",
    "ats",
    "react",
    "components",
    "monitoring"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --tsconfig tsconfig.json --import ./tests/_support/setup.ts --test --test-force-exit tests/*.test.tsx",
    "test:cov": "tsx --tsconfig tsconfig.json --import ./tests/_support/setup.ts --test --test-force-exit --experimental-test-coverage --test-coverage-include=src/** tests/*.test.tsx"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "@trueyy/web-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.4.0"
  }
}
